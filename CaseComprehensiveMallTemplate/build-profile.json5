{
  "app": {
/**todo: 配置手动签名 */
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.1.0(23)",
        "targetSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./products/entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "shopping",
      "srcPath": "./features/shopping"
    },
    {
      "name": "order",
      "srcPath": "./features/order"
    },
    {
      "name": "lib_foundation",
      "srcPath": "./commons/lib_foundation"
    },
    {
      "name": "module_shopping_cart",
      "srcPath": "./components/module_shopping_cart"
    },
    {
      "name": "module_product_search",
      "srcPath": "./components/module_product_search"
    },
    {
      "name": "module_privacy_agreement",
      "srcPath": "./components/module_privacy_agreement"
    },
    {
      "name": "module_ui_base",
      "srcPath": "./components/module_ui_base"
    },
    {
      "name": "setting",
      "srcPath": "./features/setting"
    },
    {
      "name": "lib_network",
      "srcPath": "./commons/lib_network"
    },
    {
      "name": "lib_widget",
      "srcPath": "./commons/lib_widget"
    },
    {
      "name": "module_product_review",
      "srcPath": "./components/module_product_review"
    },
    {
      "name": "module_product_category",
      "srcPath": "./components/module_product_category"
    },
    {
      "name": "module_product_scan",
      "srcPath": "./components/module_product_scan"
    },
    {
      "name": "module_product_filter",
      "srcPath": "./components/module_product_filter"
    },
    {
      "name": "module_custom_service_chat",
      "srcPath": "./components/module_custom_service_chat"
    },
    {
      "name": "product",
      "srcPath": "./features/product"
    },
    {
      "name": "module_notice_center",
      "srcPath": "./components/module_notice_center"
    },
    {
      "name": "module_transition",
      "srcPath": "./components/module_transition"
    },
    {
      "name": "module_advertisement",
      "srcPath": "./components/module_advertisement"
    },
    {
      "name": "points",
      "srcPath": "./features/points"
    },
  ]
}
